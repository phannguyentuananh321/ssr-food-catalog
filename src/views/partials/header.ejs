<header class="bg-[#FFFDF8] border-b border-[#E9E0D2] sticky top-0 z-50 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo & Brand -->
      <div class="flex items-center gap-3">
        <a href="/dishes" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-full bg-[#354B35] flex items-center justify-center text-[#FFFDF8] font-serif font-bold text-xl transition-transform group-hover:scale-105">
            Ấ
          </div>
          <div>
            <span class="font-serif text-2xl font-bold tracking-tight text-[#292820] group-hover:text-[#354B35] transition-colors">
              Ấm Vị
            </span>
            <span class="block text-xs uppercase tracking-widest text-[#B86F45] font-semibold -mt-1">
              Food Editorial
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1">
        <a href="/dishes" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors <%= (typeof currentPath !== 'undefined' && (currentPath.startsWith('/dishes') && !currentPath.startsWith('/admin'))) ? 'bg-[#FAF5EC] text-[#354B35] font-bold shadow-xs' : 'text-[#292820] hover:text-[#354B35] hover:bg-[#FAF5EC]/60' %>">
          Món Ăn
        </a>
        <a href="/chefs" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/chefs') && !currentPath.startsWith('/admin')) ? 'bg-[#FAF5EC] text-[#354B35] font-bold shadow-xs' : 'text-[#292820] hover:text-[#354B35] hover:bg-[#FAF5EC]/60' %>">
          Đầu Bếp
        </a>
        <a href="/ingredients" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/ingredients') && !currentPath.startsWith('/admin')) ? 'bg-[#FAF5EC] text-[#354B35] font-bold shadow-xs' : 'text-[#292820] hover:text-[#354B35] hover:bg-[#FAF5EC]/60' %>">
          Nguyên Liệu
        </a>
      </nav>

      <!-- Admin Actions / Dropdown -->
      <div class="hidden md:flex items-center gap-3">
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-sm bg-[#FAF5EC] hover:bg-[#E9E0D2] text-[#354B35] border border-[#E9E0D2] font-medium gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Khu vực Quản trị
          </div>
          <ul tabindex="0" class="dropdown-content menu p-2 shadow-lg bg-[#FFFDF8] border border-[#E9E0D2] rounded-box w-56 z-50 mt-2 text-sm">
            <li class="menu-title text-xs text-[#B86F45] uppercase tracking-wider font-semibold">Quản lý danh mục</li>
            <li>
              <a href="/admin/dishes" class="<%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/dishes')) ? 'active font-bold text-[#354B35]' : '' %>">
                🍳 Quản lý Món ăn
              </a>
            </li>
            <li>
              <a href="/admin/chefs" class="<%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/chefs')) ? 'active font-bold text-[#354B35]' : '' %>">
                👨‍🍳 Quản lý Đầu bếp
              </a>
            </li>
            <li>
              <a href="/admin/ingredients" class="<%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin/ingredients')) ? 'active font-bold text-[#354B35]' : '' %>">
                🌿 Quản lý Nguyên liệu
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Mobile Hamburger Menu Button -->
      <div class="flex items-center md:hidden">
        <div class="dropdown dropdown-end">
          <label tabindex="0" class="btn btn-ghost btn-circle text-[#292820]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
          </label>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-50 p-3 shadow-lg bg-[#FFFDF8] border border-[#E9E0D2] rounded-box w-64 space-y-1">
            <li class="menu-title text-xs text-[#B86F45] uppercase font-bold">Khám phá</li>
            <li><a href="/dishes">Món Ăn</a></li>
            <li><a href="/chefs">Đầu Bếp</a></li>
            <li><a href="/ingredients">Nguyên Liệu</a></li>
            <li class="menu-title text-xs text-[#B86F45] uppercase font-bold mt-2">Quản trị</li>
            <li><a href="/admin/dishes">Quản lý Món ăn</a></li>
            <li><a href="/admin/chefs">Quản lý Đầu bếp</a></li>
            <li><a href="/admin/ingredients">Quản lý Nguyên liệu</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

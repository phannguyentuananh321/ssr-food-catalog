<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl shadow-sm p-8">
    <div class="text-center mb-8">
      <div class="w-14 h-14 mx-auto rounded-full bg-[#354B35] flex items-center justify-center text-[#FFFDF8] text-2xl mb-4">
        🔐
      </div>
      <h1 class="font-serif text-3xl font-bold text-[#292820]">Đặt Lại Mật Khẩu</h1>
      <p class="text-sm text-[#7A7062] mt-2">Tạo mật khẩu mới an toàn cho tài khoản của bạn.</p>
    </div>

    <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="alert bg-[#EEF3EE] border border-[#C9D6C9] text-[#354B35] text-sm rounded-xl mb-5" role="status"><%= notice %></div>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-error text-sm rounded-xl mb-5" role="alert"><%= errorMessage %></div>
    <% } %>

    <% if (typeof isValidToken !== 'undefined' && !isValidToken) { %>
      <div class="text-center py-4">
        <p class="text-sm text-[#8A4A25] mb-6">
          <%= typeof tokenError !== 'undefined' && tokenError ? tokenError : 'Liên kết đặt lại mật khẩu không hợp lệ, đã được sử dụng hoặc đã hết hạn.' %>
        </p>
        <a href="/forgot" class="btn bg-[#354B35] hover:bg-[#273727] text-[#FFFDF8] border-none rounded-xl font-semibold">
          Yêu Cầu Liên Kết Mới
        </a>
      </div>
    <% } else { %>
      <form method="POST" action="/reset" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">

        <div>
          <label for="password" class="block text-sm font-semibold text-[#354B35] mb-1.5">Mật khẩu mới</label>
          <input id="password" name="password" type="password" required minlength="10" maxlength="64"
            autocomplete="new-password"
            class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
            placeholder="Từ 10 đến 64 ký tự">
          <p class="text-xs text-[#7A7062] mt-1">10–64 ký tự, không dùng mật khẩu quá đơn giản.</p>
          <% if (typeof errors !== 'undefined' && errors && errors.password) { %><p class="text-xs text-error mt-1"><%= errors.password %></p><% } %>
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-semibold text-[#354B35] mb-1.5">Xác nhận mật khẩu mới</label>
          <input id="confirmPassword" name="confirmPassword" type="password" required minlength="10" maxlength="64"
            autocomplete="new-password"
            class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
            placeholder="Nhập lại mật khẩu mới">
          <% if (typeof errors !== 'undefined' && errors && errors.confirmPassword) { %><p class="text-xs text-error mt-1"><%= errors.confirmPassword %></p><% } %>
        </div>

        <button type="submit"
          class="btn w-full bg-[#354B35] hover:bg-[#273727] text-[#FFFDF8] border-none rounded-xl font-semibold">
          Cập Nhật Mật Khẩu
        </button>
      </form>
    <% } %>

    <p class="text-center text-sm text-[#7A7062] mt-5">
      <a href="/login" class="text-[#354B35] hover:text-[#273727] font-semibold">Quay lại đăng nhập</a>
    </p>
  </div>
</div>

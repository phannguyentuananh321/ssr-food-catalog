<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl shadow-sm p-8">
    <div class="text-center mb-8">
      <div class="w-14 h-14 mx-auto rounded-full bg-[#354B35] flex items-center justify-center text-[#FFFDF8] font-serif font-bold text-2xl mb-4">
        Ấ
      </div>
      <h1 class="font-serif text-3xl font-bold text-[#292820]">Tạo Tài Khoản</h1>
      <p class="text-sm text-[#7A7062] mt-2">Đăng ký để khám phá và quản lý thực đơn Ấm Vị.</p>
    </div>

    <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="alert bg-[#EEF3EE] border border-[#C9D6C9] text-[#354B35] text-sm rounded-xl mb-5" role="status"><%= notice %></div>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-error text-sm rounded-xl mb-5" role="alert"><%= errorMessage %></div>
    <% } %>

    <form method="POST" action="/register" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label for="displayName" class="block text-sm font-semibold text-[#354B35] mb-1.5">Tên hiển thị (Tùy chọn)</label>
        <input id="displayName" name="displayName" type="text" maxlength="50"
          value="<%= (typeof values !== 'undefined' && (values.displayName || values.username)) ? (values.displayName || values.username) : '' %>"
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          placeholder="Họ và tên của bạn">
        <% if (typeof errors !== 'undefined' && errors && errors.displayName) { %><p class="text-xs text-error mt-1"><%= errors.displayName %></p><% } %>
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-[#354B35] mb-1.5">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          value="<%= (typeof values !== 'undefined' && values.email) ? values.email : '' %>"
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          placeholder="ban@example.com">
        <% if (typeof errors !== 'undefined' && errors && errors.email) { %><p class="text-xs text-error mt-1"><%= errors.email %></p><% } %>
      </div>

      <div>
        <label for="password" class="block text-sm font-semibold text-[#354B35] mb-1.5">Mật khẩu</label>
        <input id="password" name="password" type="password" required minlength="10" maxlength="64"
          autocomplete="new-password"
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          placeholder="Từ 10 đến 64 ký tự">
        <p class="text-xs text-[#7A7062] mt-1">10–64 ký tự, khác email và không nằm trong mật khẩu thông dụng.</p>
        <% if (typeof errors !== 'undefined' && errors && errors.password) { %><p class="text-xs text-error mt-1"><%= errors.password %></p><% } %>
      </div>

      <div>
        <label for="confirmPassword" class="block text-sm font-semibold text-[#354B35] mb-1.5">Xác nhận mật khẩu</label>
        <input id="confirmPassword" name="confirmPassword" type="password" required minlength="10" maxlength="64"
          autocomplete="new-password"
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          placeholder="Nhập lại mật khẩu">
        <% if (typeof errors !== 'undefined' && errors && errors.confirmPassword) { %><p class="text-xs text-error mt-1"><%= errors.confirmPassword %></p><% } %>
      </div>

      <div class="rounded-xl border border-[#E9E0D2] bg-[#FAF5EC] p-3 flex justify-center">
        <% if (recaptchaSiteKey) { %>
          <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>"></div>
          <script src="https://www.google.com/recaptcha/api.js" async defer></script>
        <% } else { %>
          <p class="text-xs text-[#8A4A25]">reCAPTCHA chưa được cấu hình.</p>
        <% } %>
      </div>
      <% if (typeof errors !== 'undefined' && errors && errors.captcha) { %>
        <p class="text-xs text-error text-center"><%= errors.captcha %></p>
      <% } %>

      <button type="submit"
        class="btn w-full bg-[#354B35] hover:bg-[#273727] text-[#FFFDF8] border-none rounded-xl font-semibold">
        Đăng Ký
      </button>
    </form>

    <p class="text-center text-sm text-[#7A7062] mt-5">
      Đã có tài khoản?
      <a href="/login" class="text-[#354B35] hover:text-[#273727] font-semibold">Đăng nhập</a>
    </p>
  </div>
</div>

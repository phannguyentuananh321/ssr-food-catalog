<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl shadow-sm p-8">
    <div class="text-center mb-8">
      <div class="w-14 h-14 mx-auto rounded-full bg-[#354B35] flex items-center justify-center text-[#FFFDF8] font-serif font-bold text-2xl mb-4">
        Ấ
      </div>
      <h1 class="font-serif text-3xl font-bold text-[#292820]">Tạo Tài Khoản</h1>
      <p class="text-sm text-[#7A7062] mt-2">Tài khoản mới mặc định là người dùng thường.</p>
    </div>

    <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="alert bg-[#EEF3EE] border border-[#C9D6C9] text-[#354B35] text-sm rounded-xl mb-5" role="status"><%= notice %></div>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert alert-error text-sm rounded-xl mb-5" role="alert"><%= errorMessage %></div>
    <% } %>

    <% if (!authConfigured) { %>
      <div class="alert alert-warning text-sm rounded-xl mb-5">
        Chưa cấu hình SUPABASE_URL / SUPABASE_ANON_KEY trong .env.
      </div>
    <% } %>

    <form method="POST" action="/auth/register" class="space-y-4">
      <div>
        <label for="username" class="block text-sm font-semibold text-[#354B35] mb-1.5">Tên đăng nhập</label>
        <input id="username" name="username" type="text" required minlength="3" maxlength="32"
          autocomplete="username" value="<%= values.username || '' %>"
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          placeholder="vi_du_ten">
        <p class="text-xs text-[#7A7062] mt-1">3–32 ký tự, chỉ gồm chữ, số và dấu gạch dưới.</p>
        <% if (errors && errors.username) { %><p class="text-xs text-error mt-1"><%= errors.username %></p><% } %>
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-[#354B35] mb-1.5">Email</label>
        <input id="email" name="email" type="email" required autocomplete="email"
          value="<%= values.email || '' %>"
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          placeholder="ban@example.com">
        <% if (errors && errors.email) { %><p class="text-xs text-error mt-1"><%= errors.email %></p><% } %>
      </div>

      <div>
        <label for="password" class="block text-sm font-semibold text-[#354B35] mb-1.5">Mật khẩu</label>
        <input id="password" name="password" type="password" required minlength="8" maxlength="72"
          autocomplete="new-password"
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          placeholder="Ít nhất 8 ký tự">
        <% if (errors && errors.password) { %><p class="text-xs text-error mt-1"><%= errors.password %></p><% } %>
      </div>

      <div>
        <label for="confirmPassword" class="block text-sm font-semibold text-[#354B35] mb-1.5">Xác nhận mật khẩu</label>
        <input id="confirmPassword" name="confirmPassword" type="password" required minlength="8" maxlength="72"
          autocomplete="new-password"
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          placeholder="Nhập lại mật khẩu">
        <% if (errors && errors.confirmPassword) { %><p class="text-xs text-error mt-1"><%= errors.confirmPassword %></p><% } %>
      </div>

      <div class="rounded-xl border border-[#E9E0D2] bg-[#FAF5EC] p-3">
        <% if (turnstileConfigured) { %>
          <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="light"></div>
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        <% } else { %>
          <p class="text-xs text-[#8A4A25]">CAPTCHA chưa được cấu hình (chế độ phát triển: tạm bỏ qua).</p>
        <% } %>
      </div>

      <button type="submit"
        class="btn w-full bg-[#354B35] hover:bg-[#273727] text-[#FFFDF8] border-none rounded-xl font-semibold">
        Đăng Ký
      </button>
    </form>

    <p class="text-center text-sm text-[#7A7062] mt-5">
      Đã có tài khoản?
      <a href="/auth/login" class="text-[#354B35] hover:text-[#273727] font-semibold">Đăng nhập</a>
    </p>
  </div>
</div>

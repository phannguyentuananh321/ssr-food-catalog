<!-- HERO SECTION FOR INGREDIENTS -->
<section class="relative bg-[#FAF5EC] border-b border-[#E9E0D2] overflow-hidden min-h-[380px] flex items-center">
  <div id="vanta-hero-canvas"></div>
  <div class="hero-content-wrapper max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#354B35]/10 border border-[#354B35]/20 text-[#354B35] text-xs font-semibold uppercase tracking-wider mb-4">
      Hương Vị Bản Địa
    </div>
    <h1 class="font-serif text-4xl sm:text-5xl font-bold text-[#292820] mb-4">
      Nguyên Liệu Tinh Tuyển
    </h1>
    <p class="text-base sm:text-lg text-[#7A7062] max-w-2xl mx-auto leading-relaxed">
      Từ những cánh rừng thảo mộc Tây Bắc đến vựa muối biển Phú Quốc, khám phá cội nguồn làm nên nét đặc trưng của ẩm thực đất Việt.
    </p>
  </div>
</section>

<!-- MAIN INGREDIENTS GRID -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Search & Category Filter -->
  <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl p-4 mb-10 shadow-xs">
    <form method="GET" action="/ingredients" class="flex flex-col lg:flex-row items-stretch lg:items-center gap-3">
      <div class="relative flex-grow w-full">
        <input 
          type="text" 
          name="q" 
          value="<%= typeof queryParams !== 'undefined' && queryParams.q ? queryParams.q : '' %>"
          placeholder="Tìm kiếm nguyên liệu, gia vị..." 
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
        />
      </div>
      <div class="w-full lg:w-1/4">
        <select name="category" class="select select-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm">
          <option value="all">Tất cả danh mục</option>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= typeof queryParams !== 'undefined' && queryParams.category === cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="flex items-center gap-2">
        <%- include('../partials/view-mode') %>
      </div>
      <button type="submit" class="btn bg-[#354B35] hover:bg-[#273727] text-[#FFFDF8] border-none rounded-xl font-medium px-6 w-full lg:w-auto">
        Tìm Kiếm
      </button>
      <button
        type="button"
        data-share-page
        class="btn bg-[#FFFDF8] hover:bg-[#FAF5EC] text-[#354B35] border border-[#E9E0D2] rounded-xl font-medium w-full lg:w-auto"
      >
        Chia sẻ trang này
      </button>
      <% if (typeof queryParams !== 'undefined' && (queryParams.q || queryParams.category)) { %>
        <a href="/ingredients" class="btn bg-[#FAF5EC] text-[#7A7062] hover:bg-[#E9E0D2] border border-[#E9E0D2] rounded-xl font-medium w-full lg:w-auto">
          Đặt lại
        </a>
      <% } %>
    </form>
  </div>

  <!-- Cards Grid -->
  <% if (ingredients && ingredients.length > 0) { %>
    <div
      id="catalog-grid"
      data-catalog-grid
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
    >
      <%- include('../partials/ingredient-cards', { ingredients, getImageUrl }) %>
    </div>

    <%- include('../partials/catalog-controls', {
      pagination,
      viewMode,
      apiBase,
      queryParams,
      itemLabel: 'nguyên liệu'
    }) %>

  <% } else { %>
    <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl p-12 text-center my-8">
      <h3 class="font-serif text-xl font-bold text-[#292820] mb-2">Không Tìm Thấy Nguyên Liệu</h3>
      <p class="text-sm text-[#7A7062] max-w-md mx-auto mb-6">
        Không có nguyên liệu nào khớp với từ khóa hoặc bộ lọc của bạn.
      </p>
      <a href="/ingredients" class="btn btn-sm bg-[#354B35] text-[#FFFDF8] hover:bg-[#273727] border-none rounded-xl px-5">
        Xem Tất Cả Nguyên Liệu
      </a>
    </div>
  <% } %>
</div>

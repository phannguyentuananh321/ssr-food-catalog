<!-- HERO SECTION FOR INGREDIENTS -->
<section class="relative bg-[#FAF5EC] border-b border-[#E9E0D2] overflow-hidden min-h-[380px] flex items-center">
  <div id="vanta-hero-canvas"></div>
  <div class="hero-content-wrapper max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 w-full text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#354B35]/10 border border-[#354B35]/20 text-[#354B35] text-xs font-semibold uppercase tracking-wider mb-4">
      Hương Vị Bản Địa
    </div>
    <h1 class="font-serif text-4xl sm:text-5xl font-bold text-[#292820] mb-4">
      Nguyên Liệu Tinh Tuyển
    </h1>
    <p class="text-base sm:text-lg text-[#7A7062] max-w-2xl mx-auto leading-relaxed">
      Từ những cánh rừng thảo mộc Tây Bắc đến vựa muối biển Phú Quốc, khám phá cội nguồn làm nên nét đặc trưng của ẩm thực đất Việt.
    </p>
  </div>
</section>

<!-- MAIN INGREDIENTS GRID -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Search & Category Filter -->
  <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl p-4 mb-10 shadow-xs">
    <form method="GET" action="/ingredients" class="flex flex-col sm:flex-row items-center gap-4">
      <div class="relative flex-grow w-full">
        <input 
          type="text" 
          name="q" 
          value="<%= typeof queryParams !== 'undefined' && queryParams.q ? queryParams.q : '' %>"
          placeholder="Tìm kiếm nguyên liệu, gia vị..." 
          class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
        />
      </div>
      <div class="w-full sm:w-1/3">
        <select name="category" class="select select-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm">
          <option value="all">Tất cả danh mục</option>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= typeof queryParams !== 'undefined' && queryParams.category === cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <button type="submit" class="btn bg-[#354B35] hover:bg-[#273727] text-[#FFFDF8] border-none rounded-xl font-medium px-6 w-full sm:w-auto">
        Tìm Kiếm
      </button>
      <% if (typeof queryParams !== 'undefined' && (queryParams.q || queryParams.category)) { %>
        <a href="/ingredients" class="btn bg-[#FAF5EC] text-[#7A7062] hover:bg-[#E9E0D2] border border-[#E9E0D2] rounded-xl font-medium w-full sm:w-auto">
          Đặt lại
        </a>
      <% } %>
    </form>
  </div>

  <!-- Cards Grid -->
  <% if (ingredients && ingredients.length > 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% ingredients.forEach(ing => { %>
        <article class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition-all duration-300 flex flex-col group">
          
          <!-- Image: 4:3 Ratio -->
          <div class="w-full aspect-4-3 overflow-hidden bg-[#FAF5EC] relative">
            <img 
              src="<%= getImageUrl(ing.imagePath) %>" 
              alt="<%= ing.name %>" 
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              onerror="this.src='/images/placeholder.svg'"
            />
          </div>

          <!-- Body -->
          <div class="p-6 flex flex-col flex-grow justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="inline-block text-xs font-semibold text-[#B86F45] uppercase tracking-wider">
                  <%= ing.category || 'Gia vị' %>
                </span>
                <% if (ing.unit) { %>
                  <span class="text-xs text-[#7A7062] bg-[#FAF5EC] px-2 py-0.5 rounded border border-[#E9E0D2]">
                    Đơn vị: <%= ing.unit %>
                  </span>
                <% } %>
              </div>

              <h3 class="font-serif text-xl font-bold text-[#292820] group-hover:text-[#354B35] transition-colors">
                <a href="/ingredients/<%= ing.id %>">
                  <%= ing.name %>
                </a>
              </h3>

              <p class="text-sm text-[#7A7062] line-clamp-3 leading-relaxed mt-2">
                <%= ing.description || 'Nguyên liệu tự nhiên chất lượng cao, đem lại chiều sâu hương vị cho món ăn.' %>
              </p>
            </div>

            <div class="pt-5 mt-4 border-t border-[#E9E0D2]">
              <a href="/ingredients/<%= ing.id %>" class="btn btn-sm w-full bg-[#FAF5EC] hover:bg-[#354B35] text-[#354B35] hover:text-[#FFFDF8] border border-[#E9E0D2] rounded-xl font-medium transition-colors">
                Xem Chi Tiết Nguyên Liệu »
              </a>
            </div>
          </div>

        </article>
      <% }) %>
    </div>

    <!-- Pagination -->
    <%- include('../partials/pagination') %>

  <% } else { %>
    <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl p-12 text-center my-8">
      <h3 class="font-serif text-xl font-bold text-[#292820] mb-2">Không Tìm Thấy Nguyên Liệu</h3>
      <p class="text-sm text-[#7A7062] max-w-md mx-auto mb-6">
        Không có nguyên liệu nào khớp với từ khóa hoặc bộ lọc của bạn.
      </p>
      <a href="/ingredients" class="btn btn-sm bg-[#354B35] text-[#FFFDF8] hover:bg-[#273727] border-none rounded-xl px-5">
        Xem Tất Cả Nguyên Liệu
      </a>
    </div>
  <% } %>
</div>

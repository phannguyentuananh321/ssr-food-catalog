<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <!-- Top Admin Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-[#B86F45]">Hệ Thống Quản Trị</span>
      <h1 class="font-serif text-3xl font-bold text-[#292820] mt-1">
        Quản Lý Nguyên Liệu
      </h1>
      <p class="text-sm text-[#7A7062] mt-1">
        Tổng số <%= pagination.totalItems %> nguyên liệu trong kho dữ liệu
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/ingredients" class="btn btn-sm bg-[#FAF5EC] hover:bg-[#E9E0D2] text-[#292820] border border-[#E9E0D2] rounded-xl font-medium">
        👁 Xem Trang Công Khai
      </a>
      <a href="/admin/ingredients/new" class="btn btn-sm bg-[#354B35] hover:bg-[#273727] text-[#FFFDF8] border-none rounded-xl font-medium shadow-xs">
        + Thêm Nguyên Liệu Mới
      </a>
    </div>
  </div>

  <!-- Search & Category Filter -->
  <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl p-4 mb-6 shadow-xs">
    <form method="GET" action="/admin/ingredients" class="flex flex-col sm:flex-row items-center gap-3">
      <div class="w-full sm:w-1/2">
        <input 
          type="text" 
          name="q" 
          value="<%= typeof queryParams !== 'undefined' && queryParams.q ? queryParams.q : '' %>"
          placeholder="Tìm kiếm theo tên nguyên liệu..."
          class="input input-bordered input-sm w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
        />
      </div>
      <div class="w-full sm:w-1/3">
        <select name="category" class="select select-bordered select-sm w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm">
          <option value="all">Tất cả phân loại</option>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= typeof queryParams !== 'undefined' && queryParams.category === cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="w-full sm:w-auto flex gap-2">
        <button type="submit" class="btn btn-sm bg-[#354B35] text-[#FFFDF8] hover:bg-[#273727] border-none rounded-xl px-4 font-medium">
          Lọc
        </button>
        <a href="/admin/ingredients" class="btn btn-sm bg-[#FAF5EC] text-[#7A7062] hover:bg-[#E9E0D2] border border-[#E9E0D2] rounded-xl font-medium">
          Đặt lại
        </a>
      </div>
    </form>
  </div>

  <!-- DATA TABLE -->
  <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-2xl overflow-hidden shadow-xs">
    <div class="overflow-x-auto">
      <table class="table w-full">
        <thead class="bg-[#FAF5EC] border-b border-[#E9E0D2] text-xs font-bold uppercase tracking-wider text-[#7A7062]">
          <tr>
            <th class="py-4 px-6 w-24">Hình Ảnh</th>
            <th class="py-4 px-6">Tên Nguyên Liệu & ID</th>
            <th class="py-4 px-6">Phân Loại</th>
            <th class="py-4 px-6">Đơn Vị Tính</th>
            <th class="py-4 px-6">Số Món</th>
            <th class="py-4 px-6">Cập Nhật</th>
            <th class="py-4 px-6 text-right w-40">Thao Tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#E9E0D2] text-sm">
          <% if (ingredients && ingredients.length > 0) { %>
            <% ingredients.forEach(ing => { %>
              <tr class="hover:bg-[#FAF5EC]/50 transition-colors">
                <td class="py-3 px-6">
                  <div class="w-16 aspect-4-3 rounded-lg overflow-hidden bg-[#FAF5EC] border border-[#E9E0D2]">
                    <img 
                      src="<%= getImageUrl(ing.imagePath) %>" 
                      alt="<%= ing.name %>" 
                      class="w-full h-full object-cover"
                      onerror="this.src='/images/placeholder.svg'"
                    />
                  </div>
                </td>
                <td class="py-3 px-6">
                  <div class="font-serif font-bold text-base text-[#292820]">
                    <%= ing.name %>
                  </div>
                  <div class="text-xs text-[#7A7062] mt-0.5">
                    ID: #<%= ing.id %>
                  </div>
                </td>
                <td class="py-3 px-6">
                  <span class="badge bg-[#FAF5EC] text-[#B86F45] border border-[#E9E0D2] text-xs font-medium">
                    <%= ing.category || 'Gia vị' %>
                  </span>
                </td>
                <td class="py-3 px-6 text-[#7A7062]">
                  <%= ing.unit || '—' %>
                </td>
                <td class="py-3 px-6">
                  <span class="badge bg-[#FAF5EC] text-[#354B35] border border-[#E9E0D2] text-xs font-medium">
                    🍽 <%= ing._count ? ing._count.dishes : 0 %> món
                  </span>
                </td>
                <td class="py-3 px-6 text-xs text-[#7A7062]">
                  <%= new Date(ing.updatedAt).toLocaleDateString('vi-VN') %>
                </td>
                <td class="py-3 px-6 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <a href="/admin/ingredients/<%= ing.id %>/edit" class="btn btn-xs bg-[#FAF5EC] hover:bg-[#354B35] hover:text-[#FFFDF8] text-[#354B35] border border-[#E9E0D2] rounded-lg font-medium">
                      Sửa
                    </a>
                    <button 
                      type="button" 
                      onclick="openIngDeleteModal('<%= ing.id %>', '<%= ing.name.replace(/'/g, '\\\'') %>')"
                      class="btn btn-xs bg-[#FAF5EC] hover:bg-[#B86F45] hover:text-[#FFFDF8] text-[#B86F45] border border-[#E9E0D2] rounded-lg font-medium">
                      Xóa
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-12 text-[#7A7062]">
                Chưa có nguyên liệu nào trong hệ thống.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="px-6">
      <%- include('../partials/pagination') %>
    </div>
  </div>
</div>

<!-- DELETE MODAL -->
<dialog id="deleteIngModal" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box bg-[#FFFDF8] border border-[#E9E0D2] rounded-3xl p-6 sm:p-8">
    <h3 class="font-serif font-bold text-xl text-[#292820]">Xác Nhận Xóa Nguyên Liệu</h3>
    <p class="py-4 text-sm text-[#7A7062] leading-relaxed">
      Bạn có chắc chắn muốn xóa nguyên liệu <span id="modalIngName" class="font-bold text-[#292820]"></span> không?
      Hành động này sẽ xóa dữ liệu vĩnh viễn và không thể hoàn tác.
    </p>

    <form id="deleteIngForm" method="POST" action="">
      <input type="hidden" name="_method" value="DELETE" />
      <div class="modal-action flex justify-end gap-3 mt-6">
        <button type="button" onclick="closeIngDeleteModal()" class="btn btn-sm bg-[#FAF5EC] hover:bg-[#E9E0D2] text-[#292820] border border-[#E9E0D2] rounded-xl px-4">
          Hủy Bỏ
        </button>
        <button type="submit" class="btn btn-sm bg-[#B86F45] hover:bg-[#985732] text-[#FFFDF8] border-none rounded-xl px-5 font-medium shadow-xs">
          Xác Nhận Xóa
        </button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button onclick="closeIngDeleteModal()">close</button>
  </form>
</dialog>

<script>
  function openIngDeleteModal(id, name) {
    const modal = document.getElementById('deleteIngModal');
    const form = document.getElementById('deleteIngForm');
    const nameSpan = document.getElementById('modalIngName');
    
    form.action = `/admin/ingredients/${id}?_method=DELETE`;
    nameSpan.textContent = `"${name}"`;
    modal.showModal();
  }

  function closeIngDeleteModal() {
    const modal = document.getElementById('deleteIngModal');
    modal.close();
  }
</script>

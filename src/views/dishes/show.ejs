<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <!-- Breadcrumb / Back button -->
  <div class="mb-6 flex items-center justify-between">
    <a href="/dishes" class="inline-flex items-center gap-2 text-sm font-medium text-[#7A7062] hover:text-[#354B35] transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Quay lại Danh Sách Thực Đơn
    </a>
    <div class="flex items-center gap-2">
      <a href="/admin/dishes/<%= dish.id %>/edit" class="btn btn-xs bg-[#FAF5EC] hover:bg-[#E9E0D2] text-[#354B35] border border-[#E9E0D2] rounded-lg">
        ✎ Quản trị món này
      </a>
    </div>
  </div>

  <!-- Detail Container: Clean 2-column flexbox to guarantee no overlap -->
  <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-3xl overflow-hidden shadow-xs flex flex-col md:flex-row">
    
    <!-- Dish Image (Clean 4:3 container, strict width & height bounds) -->
    <div class="w-full md:w-1/2 bg-[#FAF5EC] relative flex-shrink-0 flex items-center justify-center overflow-hidden border-b md:border-b-0 md:border-r border-[#E9E0D2]">
      <div class="w-full aspect-4-3 relative overflow-hidden">
        <img 
          src="<%= getImageUrl(dish.imagePath) %>" 
          alt="<%= dish.name %>" 
          class="w-full h-full object-cover block"
          onerror="this.src='/images/placeholder.svg'"
        />
        <% if (dish.isFeatured) { %>
          <span class="absolute top-4 left-4 bg-[#354B35] text-[#FFFDF8] text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider shadow-sm z-10">
            ★ Món Nổi Bật Tuyển Chọn
          </span>
        <% } %>
      </div>
    </div>

    <!-- Dish Details Content -->
    <div class="w-full md:w-1/2 p-6 sm:p-10 lg:p-12 flex flex-col justify-between space-y-6">
      <div>
        <!-- Category -->
        <div class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#B86F45]/15 text-[#B86F45] mb-3">
          <%= dish.category %>
        </div>

        <!-- Title -->
        <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-[#292820] leading-tight mb-3">
          <%= dish.name %>
        </h1>

        <!-- Price Highlight -->
        <div class="text-2xl sm:text-3xl font-bold text-[#354B35] mb-5">
          <%= dish.price ? Number(dish.price).toLocaleString('vi-VN') + ' ₫' : 'Liên hệ' %>
        </div>

        <!-- Divider -->
        <div class="w-16 h-1 bg-[#354B35] rounded-full mb-6"></div>

        <!-- Description -->
        <div class="text-[#7A7062] leading-relaxed text-sm sm:text-base space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-[#292820]">
            Câu Chuyện & Hương Vị
          </h4>
          <p>
            <%= dish.description || 'Món ăn mang đậm phong vị Việt Nam, được chế biến từ những nguyên liệu tươi ngon chọn lọc theo công thức độc đáo.' %>
          </p>
        </div>
      </div>

      <!-- Meta info -->
      <div class="pt-6 border-t border-[#E9E0D2] flex items-center justify-between text-xs text-[#7A7062]">
        <span>Mã món: #DISH-<%= dish.id %></span>
        <span>Cập nhật: <%= new Date(dish.updatedAt).toLocaleDateString('vi-VN') %></span>
      </div>
    </div>

  </div>
</div>

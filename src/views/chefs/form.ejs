<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <a href="/admin/chefs" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#7A7062] hover:text-[#354B35] transition-colors mb-2">
        ← Quay lại Danh sách Đầu Bếp
      </a>
      <h1 class="font-serif text-3xl font-bold text-[#292820]">
        <%= isEdit ? 'Chỉnh Sửa Hồ Sơ Đầu Bếp' : 'Thêm Đầu Bếp Mới' %>
      </h1>
      <p class="text-sm text-[#7A7062] mt-1">
        <%= isEdit ? 'Cập nhật thông tin chuyên môn và chân dung đầu bếp.' : 'Tạo hồ sơ nghệ nhân ẩm thực mới cho website.' %>
      </p>
    </div>
  </div>

  <div class="bg-[#FFFDF8] border border-[#E9E0D2] rounded-3xl p-8 sm:p-10 shadow-xs">
    <form 
      method="POST" 
      action="<%= isEdit ? '/admin/chefs/' + chef.id + '?_method=PATCH' : '/admin/chefs' %>" 
      enctype="multipart/form-data" 
      class="space-y-6">
      
      <% if (isEdit) { %>
        <input type="hidden" name="_method" value="PATCH" />
      <% } %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Name -->
        <div class="sm:col-span-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-[#292820] mb-2">
            Họ & Tên Đầu Bếp <span class="text-[#B86F45]">*</span>
          </label>
          <input 
            type="text" 
            name="name" 
            required
            value="<%= typeof chef !== 'undefined' && chef.name ? chef.name : '' %>"
            placeholder="Ví dụ: Nguyễn Thanh Tùng"
            class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm <%= errors && errors.name ? 'border-red-500 bg-red-50/20' : '' %>"
          />
          <% if (errors && errors.name) { %>
            <p class="text-xs text-red-600 mt-1.5 font-medium"><%= errors.name %></p>
          <% } %>
        </div>

        <!-- Title -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-[#292820] mb-2">
            Chức Danh / Vị Trí
          </label>
          <input 
            type="text" 
            name="title" 
            value="<%= typeof chef !== 'undefined' && chef.title ? chef.title : '' %>"
            placeholder="Ví dụ: Bếp trưởng Điều hành"
            class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          />
        </div>

        <!-- Experience -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-[#292820] mb-2">
            Kinh Nghiệm Chuyên Môn
          </label>
          <input 
            type="text" 
            name="experience" 
            value="<%= typeof chef !== 'undefined' && chef.experience ? chef.experience : '' %>"
            placeholder="Ví dụ: 15 năm kinh nghiệm"
            class="input input-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm"
          />
        </div>

        <!-- Featured Checkbox -->
        <div class="sm:col-span-2">
          <label class="flex items-center gap-3 cursor-pointer p-4 bg-[#FAF5EC] border border-[#E9E0D2] rounded-2xl hover:border-[#354B35] transition-colors">
            <input 
              type="checkbox" 
              name="isFeatured" 
              value="true"
              class="checkbox checkbox-sm checkbox-success"
              <%= (typeof chef !== 'undefined' && (chef.isFeatured === true || chef.isFeatured === 'true')) ? 'checked' : '' %>
            />
            <div>
              <span class="text-sm font-bold text-[#292820]">Đặt làm Đầu Bếp Tiêu Biểu</span>
              <p class="text-xs text-[#7A7062]">Hồ sơ đầu bếp sẽ được ưu tiên hiển thị nổi bật.</p>
            </div>
          </label>
        </div>

        <!-- Image Upload & Preview -->
        <div class="sm:col-span-2 space-y-3">
          <label class="block text-xs font-bold uppercase tracking-wider text-[#292820]">
            Ảnh Chân Dung (Tỉ lệ chuẩn 4:3)
          </label>
          
          <div class="flex flex-col sm:flex-row items-start gap-6">
            <div class="w-48 aspect-4-3 rounded-2xl overflow-hidden bg-[#FAF5EC] border border-[#E9E0D2] shrink-0 relative">
              <% const initialImage = (typeof chef !== 'undefined' && chef.imagePath) ? getImageUrl(chef.imagePath) : '/images/placeholder.svg'; %>
              <img 
                id="chef-image-preview" 
                src="<%= initialImage %>" 
                alt="Xem trước hình ảnh" 
                class="w-full h-full object-cover"
                onerror="this.src='/images/placeholder.svg'"
              />
            </div>

            <div class="flex-grow space-y-2">
              <input 
                type="file" 
                name="image" 
                accept="image/jpeg,image/png,image/webp"
                onchange="previewImage(event, 'chef-image-preview')"
                class="file-input file-input-bordered file-input-sm w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] rounded-xl text-sm"
              />
              <p class="text-xs text-[#7A7062]">
                <% if (isEdit) { %>
                  <span class="text-[#354B35] font-semibold">Ghi chú:</span> Không chọn ảnh nếu muốn giữ ảnh chân dung hiện tại.
                <% } else { %>
                  Hình ảnh sẽ được tải lên Supabase Storage bucket <code>dish-images</code> (thư mục <code>chefs/</code>).
                <% } %>
              </p>
            </div>
          </div>
        </div>

        <!-- Description -->
        <div class="sm:col-span-2">
          <label class="block text-xs font-bold uppercase tracking-wider text-[#292820] mb-2">
            Tiểu Sử & Triết Lý Ẩm Thực
          </label>
          <textarea 
            name="description" 
            rows="4"
            placeholder="Mô tả quá trình học nghề, giải thưởng, phong cách nấu ăn và niềm đam mê với ẩm thực..."
            class="textarea textarea-bordered w-full bg-[#FAF5EC] border-[#E9E0D2] focus:border-[#354B35] focus:outline-none rounded-xl text-sm leading-relaxed"><%= typeof chef !== 'undefined' && chef.description ? chef.description : '' %></textarea>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-6 border-t border-[#E9E0D2]">
        <a href="/admin/chefs" class="btn btn-sm bg-[#FAF5EC] hover:bg-[#E9E0D2] text-[#292820] border border-[#E9E0D2] rounded-xl px-5 font-medium">
          Hủy Bỏ
        </a>
        <button type="submit" class="btn btn-sm bg-[#354B35] hover:bg-[#273727] text-[#FFFDF8] border-none rounded-xl px-7 font-medium shadow-xs">
          <%= isEdit ? 'Lưu Thay Đổi' : 'Thêm Đầu Bếp' %>
        </button>
      </div>

    </form>
  </div>
</div>

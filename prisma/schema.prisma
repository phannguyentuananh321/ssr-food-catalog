datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  price       Int      @default(0)
  category    String   @default("Món chính")
  imagePath   String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Many-to-many relations. Optional: a Dish may have zero ingredients/chefs.
  ingredients DishIngredient[]
  chefs       DishChef[]

  @@index([category])
  @@index([price])
  @@index([createdAt])
}

model Chef {
  id          Int      @id @default(autoincrement())
  name        String
  title       String?
  description String?  @db.Text
  experience  String?
  imagePath   String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Dishes this chef is able to cook (many-to-many, optional).
  dishes DishChef[]

  @@index([createdAt])
}

model Ingredient {
  id          Int      @id @default(autoincrement())
  name        String
  category    String?  @default("Gia vị")
  description String?  @db.Text
  unit        String?  @default("gram")
  imagePath   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Dishes that use this ingredient (many-to-many, optional).
  dishes DishIngredient[]

  @@index([category])
  @@index([createdAt])
}

// Explicit join model: Dish <-> Ingredient
model DishIngredient {
  id           Int        @id @default(autoincrement())
  dishId       Int
  ingredientId Int
  createdAt    DateTime   @default(now())

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([dishId, ingredientId])
  @@index([dishId])
  @@index([ingredientId])
}

// Explicit join model: Dish <-> Chef
model DishChef {
  id        Int      @id @default(autoincrement())
  dishId    Int
  chefId    Int
  createdAt DateTime @default(now())

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)
  chef Chef @relation(fields: [chefId], references: [id], onDelete: Restrict)

  @@unique([dishId, chefId])
  @@index([dishId])
  @@index([chefId])
}

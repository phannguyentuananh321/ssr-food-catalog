datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  price       Int      @default(0)
  category    String   @default("Món chính")
  imagePath   String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Many-to-many relations. Optional: a Dish may have zero ingredients/chefs.
  ingredients DishIngredient[]
  chefs       DishChef[]

  @@index([category])
  @@index([price])
  @@index([createdAt])
}

model Chef {
  id          Int      @id @default(autoincrement())
  name        String
  title       String?
  description String?  @db.Text
  experience  String?
  imagePath   String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Dishes this chef is able to cook (many-to-many, optional).
  dishes DishChef[]

  @@index([createdAt])
}

model Ingredient {
  id          Int      @id @default(autoincrement())
  name        String
  category    String?  @default("Gia vị")
  description String?  @db.Text
  unit        String?  @default("gram")
  imagePath   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Dishes that use this ingredient (many-to-many, optional).
  dishes DishIngredient[]

  @@index([category])
  @@index([createdAt])
}

// Explicit join model: Dish <-> Ingredient
model DishIngredient {
  id           Int        @id @default(autoincrement())
  dishId       Int
  ingredientId Int
  createdAt    DateTime   @default(now())

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([dishId, ingredientId])
  @@index([dishId])
  @@index([ingredientId])
}

// Explicit join model: Dish <-> Chef
model DishChef {
  id        Int      @id @default(autoincrement())
  dishId    Int
  chefId    Int
  createdAt DateTime @default(now())

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)
  chef Chef @relation(fields: [chefId], references: [id], onDelete: Restrict)

  @@unique([dishId, chefId])
  @@index([dishId])
  @@index([chefId])
}

// Custom Authentication Models (Session + Cookie + Argon2id)
model User {
  id              String               @id @default(uuid())
  email           String
  emailNormalized String               @unique
  displayName     String?
  passwordHash    String
  role            String               @default("viewer")
  status          String               @default("pending")
  emailVerifiedAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  activationChallenge ActivationChallenge?
  passwordResets      PasswordReset[]
  sessions            Session[]
}

model ActivationChallenge {
  id              String    @id @default(uuid())
  userId          String    @unique
  purpose         String    @default("activation")
  otpHash         String
  expiresAt       DateTime
  usedAt          DateTime?
  attempts        Int       @default(0)
  lockedUntil     DateTime?
  lastSentAt      DateTime  @default(now())
  sendCount       Int       @default(1)
  sendWindowStart DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  sid       String   @id
  userId    String?
  data      String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

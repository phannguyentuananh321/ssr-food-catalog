{
  "name": "food-catalog-ssr",
  "version": "1.0.0",
  "description": "SSR Food Catalog with Express, EJS, Prisma, PostgreSQL (Supabase) and Tailwind/DaisyUI",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:demo": "node prisma/seed.js --demo",
    "test": "node tests/run-tests.js"
  },
  "keywords": [
    "express",
    "ssr",
    "ejs",
    "prisma",
    "postgresql",
    "supabase",
    "food-catalog"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.9",
    "daisyui": "^5.0.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.0.9"
  }
}

# ==========================================
# FOOD CATALOG SSR — ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL / Supabase Database
# For runtime query pooling (Session / Transaction pooler or Direct)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# Direct URL used for Prisma CLI migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Storage Configuration (Server-side privileged client)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=dish-images

# Session secret (if session authentication is enabled)
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

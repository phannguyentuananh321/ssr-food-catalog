# ==========================================
# FOOD CATALOG SSR — ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL / Supabase Database
# For runtime query pooling (Session / Transaction pooler or Direct)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# Direct URL used for Prisma CLI migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Storage Configuration (Server-side privileged client - only for media files)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=dish-images

# Session Secret (at least 32 characters)
SESSION_SECRET=your_session_secret_at_least_32_characters_long_here

# OTP Pepper (at least 32 characters)
OTP_PEPPER=your_otp_pepper_at_least_32_characters_long_here

# Google reCAPTCHA v2 (server-side verification)
# For local dev / testing, you can use Google's official test keys:
# Site Key:   6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Secret Key: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# SMTP Configuration (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Ấm Vị <no-reply@amvi.local>"

# Registration rate limit (per IP, fixed window)
REGISTRATION_LIMIT=5
REGISTRATION_WINDOW_MINUTES=60

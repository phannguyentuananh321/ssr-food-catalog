# ==========================================
# FOOD CATALOG SSR — ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL / Supabase Database
# For runtime query pooling (Session / Transaction pooler or Direct)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# Direct URL used for Prisma CLI migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Storage Configuration (Server-side privileged client)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Publishable/anon key — safe to expose to the browser; used by Supabase Auth
SUPABASE_ANON_KEY=your_supabase_publishable_key_here
SUPABASE_STORAGE_BUCKET=dish-images

# Session secret (legacy; Supabase Auth owns session cookies)
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# The ONLY admin account. Must be a verified Supabase Auth email.
# Never hardcode this in frontend code.
ADMIN_EMAIL=your-admin@gmail.com

# Cloudflare Turnstile (server-side verification)
# Real keys start with 0x... — create a widget at https://dash.cloudflare.com
# (Turnstile -> Add widget) and add localhost + your production domain.
# Test keys below render a "Testing only" badge, always pass, and are REJECTED
# when NODE_ENV=production (the app refuses to start).
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Registration rate limit (per IP, fixed window)
REGISTRATION_LIMIT=5
REGISTRATION_WINDOW_MINUTES=60

# Optional: enable opt-in demo seeding (development/demo only, never production)
# SEED_DEMO=true
